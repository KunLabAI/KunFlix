# =============================================================================
# KunFlix Production - Compose/Backend 环境变量样例
# 复制为 .env.prod 后按实际值填写（.env.prod 禁止提交仓库！）
# =============================================================================

# -----------------------------------------------------------------------------
# 域名（用于 Nginx server_name + CORS + certbot）
# -----------------------------------------------------------------------------
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PostgreSQL（compose 用于注入 postgres 容器 + 拼接 DATABASE_URL）
# 密码务必修改为高强度随机值！
# -----------------------------------------------------------------------------
POSTGRES_DB=kunflix
POSTGRES_USER=kunflix
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# -----------------------------------------------------------------------------
# Security
#   生成方式：
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#     openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
JWT_SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Models
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
STORY_GENERATION_MODEL=gpt-4-turbo

# -----------------------------------------------------------------------------
# 限流/熔断/审计（compose 已覆盖默认开启；如需微调在此调整）
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_CHAT_SEND=60/minute
RATE_LIMIT_VIDEO_CREATE=20/minute
RATE_LIMIT_IMAGE_GENERATE=20/minute
RATE_LIMIT_MUSIC_CREATE=20/minute
RATE_LIMIT_ORCHESTRATE=30/minute
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TTL=30

# -----------------------------------------------------------------------------
# SSE resumable stream
# -----------------------------------------------------------------------------
SSE_STREAM_MAXLEN=1000
SSE_STREAM_TTL_SEC=600
SSE_RESUME_MAX_COUNT=500

# -----------------------------------------------------------------------------
# Backend 数据库连接池（PostgreSQL 推荐）
# -----------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
